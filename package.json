{
  "name": "novel-context-manager",
  "version": "0.1.0",
  "description": "长篇小说导入与上下文管理桌面应用",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node test/novel-core.test.mjs && node test/think-filter.test.mjs",
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:win:portable": "electron-builder --win portable",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.local.novelcontextmanager",
    "productName": "长篇小说上下文管理",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "src/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "长篇小说上下文管理"
    }
  },
  "devDependencies": {
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12"
  }
}
